# 复制为 .env 后再填写。本文件会提交到 Git，禁止写入真实密钥。
#
#   cp .env.example .env

# --- 项目 --------------------------------------------------------------------
PROJECT_NAME="ApplyPilot"
COMPOSE_PROJECT_NAME=applypilot
STACK_NAME=applypilot
ENVIRONMENT=local
DOMAIN=localhost
FRONTEND_HOST=http://localhost:5173
BACKEND_CORS_ORIGINS="http://localhost,http://localhost:5173"
SECRET_KEY=changethis

# --- PostgreSQL --------------------------------------------------------------
POSTGRES_SERVER=localhost
POSTGRES_PORT=5432
POSTGRES_DB=applypilot
POSTGRES_USER=applypilot
POSTGRES_PASSWORD=changethis

# --- 初始管理员 ---------------------------------------------------------------
# `python -m app.initial_data` 会创建该账号，命令行演示也使用它。
FIRST_SUPERUSER=admin@example.com
FIRST_SUPERUSER_PASSWORD=changethis

# --- Agent 运行配置 -----------------------------------------------------------
# 接口需兼容 Anthropic Messages 协议。下面三个配置缺一不可；地址为空时会停止运行，
# 不会自动切换到其他模型服务。
#
# AGENT_API_KEY 留空时 Agent 保持离线，真实模型测试会跳过，其余测试仍可运行。
AGENT_BASE_URL=https://api.deepseek.com/anthropic
AGENT_API_KEY=
AGENT_MODEL=deepseek-v4-flash

# LangGraph checkpoint 的加密密钥，必须是 16、24 或 32 字节。
# checkpoint 里会存下完整对话与工具结果，所以与 SECRET_KEY 分开管理；
# 没有配置时 checkpoint 初始化会直接失败，不会退回明文存储。
# 生成：python -c "import secrets; print(secrets.token_urlsafe(24)[:32])"
CHECKPOINT_ENCRYPTION_KEY=

# --- 可选配置 -----------------------------------------------------------------
SENTRY_DSN=
DOCKER_IMAGE_BACKEND=applypilot-backend

# 只有发送密码找回邮件时才需要 SMTP。
SMTP_HOST=
SMTP_USER=
SMTP_PASSWORD=
SMTP_PORT=587
SMTP_TLS=True
SMTP_SSL=False
EMAILS_FROM_EMAIL=
