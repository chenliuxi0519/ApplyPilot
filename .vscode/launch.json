{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "调试 ApplyPilot 后端",
            "type": "debugpy",
            "request": "launch",
            "module": "uvicorn",
            "args": [
                "app.main:app",
                "--reload"
            ],
            "cwd": "${workspaceFolder}/backend",
            "jinja": true,
            "envFile": "${workspaceFolder}/.env",
        },
        {
            "type": "chrome",
            "request": "launch",
            "name": "调试 ApplyPilot 前端",
            "url": "http://localhost:5173",
            "webRoot": "${workspaceFolder}/frontend"
        },
    ]
}
